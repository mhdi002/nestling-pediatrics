# VCS / cache
.git
.gitignore
**/__pycache__
**/*.py[cod]
**/*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache
.venv
venv
env

# IDE / OS
.idea
.vscode
*.swp
.DS_Store
Thumbs.db

# Local agent / temp dumps (mirrors the `_*` rules in .gitignore)
preview_*.png
_*
!__init__.py
!__main__.py
agent-transcripts
.cursor

# Performance/load-test harness: dev-only, never needed in the runtime image
perf
requirements-dev.txt

# Tests not needed in runtime image
tests
*.pyc
.coverage
htmlcov
dist
build

# Large source PDFs (extracted/ + data/en already shipped)
*.pdf

# Heavy optional model caches if present locally
.cache
**/huggingface
**/torch_cache
